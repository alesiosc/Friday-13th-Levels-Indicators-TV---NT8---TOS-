			return CacheIndicator<NT8LevelsIndicator>(new NT8LevelsIndicator(){ FullLevelsFilePath = fullLevelsFilePath, AutoLoadFromFile = autoLoadFromFile, FileCheckIntervalSeconds = fileCheckIntervalSeconds, ShowLIS = showLIS, Set1Data = set1Data, Set2Data = set2Data, Set3Data = set3Data, Set4Data = set4Data, Set5Data = set5Data, Set6Data = set6Data, Set7Data = set7Data, Set1ShowZones = set1ShowZones, Set1ShowLabels = set1ShowLabels, Set2ShowZones = set2ShowZones, Set2ShowLabels = set2ShowLabels, Set3ShowKeyLevels = set3ShowKeyLevels, Set3ShowKeyLabels = set3ShowKeyLabels, Set3ShowTimestamp = set3ShowTimestamp, Set4ShowZones = set4ShowZones, Set4ShowLabels = set4ShowLabels, Set5ShowZones = set5ShowZones, Set5ShowLabels = set5ShowLabels, Set6ShowZones = set6ShowZones, Set6ShowLabels = set6ShowLabels, Set7ShowZones = set7ShowZones, Set7ShowLabels = set7ShowLabels, LabelOnRight = labelOnRight, LabelXOffset = labelXOffset, LabelSize = labelSize, LabelYOffset = labelYOffset, LabelBold = labelBold, LabelItalic = labelItalic, Set4RightSideLabels = set4RightSideLabels }, input, ref cacheNT8LevelsIndicator);
		}
	}
}

